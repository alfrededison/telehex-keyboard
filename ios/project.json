{
  "name": "TeleHex",
  "options": {
    "deploymentTarget": {
      "iOS": "16.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "IPHONEOS_DEPLOYMENT_TARGET": "16.0",
      "CURRENT_PROJECT_VERSION": "1",
      "MARKETING_VERSION": "0.1.0",
      "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
      "CODE_SIGN_STYLE": "Automatic",
      "FRAMEWORK_SEARCH_PATHS": [
        "$(inherited)",
        "$(SRCROOT)/../telex/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
      ],
      "OTHER_LDFLAGS": [
        "$(inherited)",
        "-framework",
        "TeleHexCore"
      ],
      "TARGETED_DEVICE_FAMILY": "1,2",
      "ARCHS": "arm64"
    }
  },
  "targets": {
    "TeleHex": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "Sources/App",
        "Sources/Shared",
        {
          "path": "../app/src/main/assets",
          "buildPhase": "resources"
        },
        {
          "path": "Resources/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.telehex.keyboard",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon"
        }
      },
      "preBuildScripts": [
        {
          "name": "Build shared Kotlin engine",
          "script": "\"$SRCROOT/scripts/kmp-build.sh\"",
          "basedOnDependencyAnalysis": false
        }
      ],
      "info": {
        "path": "Generated/App-Info.plist",
        "properties": {
          "CFBundleDisplayName": "TeleHex",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight",
            "UIInterfaceOrientationPortraitUpsideDown"
          ],
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false,
            "UISceneConfigurations": {
              "UIWindowSceneSessionRoleApplication": [
                {
                  "UISceneConfigurationName": "Default",
                  "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
                }
              ]
            }
          },
          "ITSAppUsesNonExemptEncryption": false
        }
      },
      "dependencies": [
        {
          "target": "TeleHexKeyboard"
        }
      ],
      "entitlements": {
        "path": "Generated/App.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.telehex.keyboard.shared"
          ]
        }
      }
    },
    "TeleHexKeyboard": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        "Sources/Keyboard",
        "Sources/Shared",
        {
          "path": "../app/src/main/assets",
          "buildPhase": "resources"
        },
        {
          "path": "Resources/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.telehex.keyboard.extension",
          "APPLICATION_EXTENSION_API_ONLY": "YES",
          "SKIP_INSTALL": "YES"
        }
      },
      "preBuildScripts": [
        {
          "name": "Build shared Kotlin engine",
          "script": "\"$SRCROOT/scripts/kmp-build.sh\"",
          "basedOnDependencyAnalysis": false
        }
      ],
      "info": {
        "path": "Generated/Keyboard-Info.plist",
        "properties": {
          "CFBundleDisplayName": "TeleHex",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.keyboard-service",
            "NSExtensionPrincipalClass": "$(PRODUCT_MODULE_NAME).KeyboardViewController",
            "NSExtensionAttributes": {
              "IsASCIICapable": true,
              "PrimaryLanguage": "vi-VN",
              "RequestsOpenAccess": true
            }
          },
          "ITSAppUsesNonExemptEncryption": false
        }
      },
      "entitlements": {
        "path": "Generated/Keyboard.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.telehex.keyboard.shared"
          ]
        }
      }
    },
    "TeleHexTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": [
        "Tests",
        {
          "path": "../telex/src/test/resources/golden.tsv",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": "YES",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.telehex.keyboard.tests"
        }
      },
      "dependencies": [
        {
          "target": "TeleHex"
        }
      ]
    },
    "TeleHexUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests"
      ],
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": "YES",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.telehex.keyboard.uitests"
        }
      },
      "dependencies": [
        {
          "target": "TeleHex"
        }
      ]
    }
  },
  "schemes": {
    "TeleHex": {
      "build": {
        "targets": {
          "TeleHex": "all"
        }
      },
      "test": {
        "targets": [
          "TeleHexTests",
          "TeleHexUITests"
        ]
      }
    }
  },
  "configFiles": {
    "Debug": "Config/Base.xcconfig",
    "Release": "Config/Base.xcconfig"
  }
}
